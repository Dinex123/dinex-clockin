# ══════════════════════════════════════════════
# DinEX WebClock — Variables de entorno
# Copia este archivo como .env y completa los valores
# NUNCA subas .env a GitHub — ya está en .gitignore
# ══════════════════════════════════════════════

# Puerto del servidor (Render lo asigna automáticamente)
PORT=3000

# Directorio de datos (en Render usar /data para persistencia)
# En desarrollo local dejar vacío o usar la ruta del proyecto
DATA_DIR=

